# ─── LiveKit ──────────────────────────────────────────────
# Get these from https://cloud.livekit.io (Project → Settings → Keys)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Server ───────────────────────────────────────────────
PORT=3001
# Comma-separated list of additional allowed CORS origins
# (the production Vercel domain and localhost:5173 are already allowed)
ALLOWED_ORIGINS=

# ─── NexMeet AI agent (Groq) ──────────────────────────────
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to llama-3.1-8b-instant if unset
GROQ_MODEL=llama-3.1-8b-instant
